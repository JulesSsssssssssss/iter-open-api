{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource Grafana Cloud Prometheus alimentée par Grafana Alloy",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "VPS - Conteneurs & API open-dpp-api",
  "tags": ["docker", "cadvisor", "iter-open-api", "cours-devops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Conteneur",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": {
          "query": "label_values(container_memory_working_set_bytes, name)",
          "refId": "container"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "Vue d'ensemble", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "stat", "title": "Conteneurs actifs",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "count(count by (name) (container_memory_working_set_bytes{name=~\"$container\", name!=\"\"}))", "refId": "A" }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "CPU total (coeurs)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"$container\", name!=\"\"}[$__rate_interval]))", "refId": "A" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "RAM totale",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{name=~\"$container\", name!=\"\"})", "refId": "A" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Réseau total",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(container_network_receive_bytes_total{name=~\"$container\", name!=\"\"}[$__rate_interval])) + sum(rate(container_network_transmit_bytes_total{name=~\"$container\", name!=\"\"}[$__rate_interval]))", "refId": "A" }
      ]
    },

    { "id": 101, "type": "row", "title": "Conteneurs (cAdvisor)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 10, "type": "timeseries", "title": "CPU par conteneur (coeurs)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "RAM par conteneur (working set)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$container\", name!=\"\"})", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Réseau RX par conteneur",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"$container\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Réseau TX par conteneur",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"$container\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Espace disque par conteneur",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (name) (container_fs_usage_bytes{name=~\"$container\", name!=\"\"})", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 15, "type": "timeseries", "title": "I/O disque (read/write)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/.*write.*/" },
            "properties": [{ "id": "custom.transform", "value": "negative-Y" }]
          }
        ]
      },
      "targets": [
        { "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=~\"$container\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}} - read", "refId": "A" },
        { "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\"$container\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{name}} - write", "refId": "B" }
      ]
    },

    { "id": 102, "type": "row", "title": "API open-dpp-api", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 } },
    {
      "id": 20, "type": "timeseries", "title": "Requêtes / s par route et code HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (path, status) (rate(http_requests_total{job=\"open-dpp-api\"}[$__rate_interval]))", "legendFormat": "{{path}} - {{status}}", "refId": "A" }
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Latence par route (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, path) (rate(http_request_duration_seconds_bucket{job=\"open-dpp-api\"}[$__rate_interval])))", "legendFormat": "p50 {{path}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{job=\"open-dpp-api\"}[$__rate_interval])))", "legendFormat": "p95 {{path}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, path) (rate(http_request_duration_seconds_bucket{job=\"open-dpp-api\"}[$__rate_interval])))", "legendFormat": "p99 {{path}}", "refId": "C" }
      ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Taux d'erreurs 5xx",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"open-dpp-api\", status=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx", "refId": "A" }
      ]
    },
    {
      "id": 23, "type": "timeseries", "title": "Process API (CPU, RAM, goroutines)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"open-dpp-api\"}[$__rate_interval])", "legendFormat": "CPU (coeurs)", "refId": "A" },
        { "expr": "process_resident_memory_bytes{job=\"open-dpp-api\"} / 1024 / 1024", "legendFormat": "RAM (Mo)", "refId": "B" },
        { "expr": "go_goroutines{job=\"open-dpp-api\"}", "legendFormat": "Goroutines", "refId": "C" }
      ]
    }
  ]
}
